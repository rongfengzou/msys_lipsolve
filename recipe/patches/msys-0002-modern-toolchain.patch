+// Small POSIX path helpers; replace boost::filesystem so that libmsys does
+// not link against any boost runtime library.
+namespace {
+    std::string path_parent(const std::string& p) {
+        std::string::size_type n = p.rfind('/');
+        if (n == std::string::npos) return ".";
+        if (n == 0) return "/";
+        return p.substr(0, n);
+    }
+    bool path_is_absolute(const std::string& p) {
+        return !p.empty() && p[0] == '/';
+    }
+    // If p is a symlink, return its target (as written in the link),
+    // otherwise return p unchanged.
+    std::string path_resolve_symlink(const std::string& p) {
+        struct stat st;
+        if (lstat(p.c_str(), &st) != 0 || !S_ISLNK(st.st_mode)) return p;
+        std::vector<char> buf(PATH_MAX + 1);
+        ssize_t n = readlink(p.c_str(), buf.data(), PATH_MAX);
+        if (n < 0) return p;
+        std::string target(buf.data(), n);
+        // a relative symlink target is relative to the link's directory
+        if (!path_is_absolute(target)) target = path_parent(p) + "/" + target;
+        return target;
+    }
+}
 
 static const char SERIALIZED_VERSION[] = "0008";
 
